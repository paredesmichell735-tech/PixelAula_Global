# ---------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Orígenes permitidos por CORS, separados por coma (solo la web los necesita;
# la app Android no envía Origin y no pasa por CORS).
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# ---------------------------------------------------------------------
# Supabase · Project Settings > API
# ---------------------------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
# NUNCA exponer esta clave a los clientes. Solo backend.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# Bucket de Storage con los sprites
ASSETS_BUCKET=assets
ASSETS_PUBLIC=true
ASSETS_SIGNED_URL_TTL=3600

# ---------------------------------------------------------------------
# IA · proveedor detrás de la interfaz AIProvider
# anthropic | mock   (mock no llama a la red: úsalo en tests y desarrollo)
# ---------------------------------------------------------------------
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=claude-opus-5
AI_MAX_TOKENS=4096
AI_TIMEOUT_MS=45000
AI_MAX_RETRIES=2

# ---------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=10
