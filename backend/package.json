{
  "name": "pixelaula-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend de PixelAula: plataforma educativa gamificada multi-materia. Consumido por la web y la app movil a traves del contrato @pixelaula/api.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:new": "supabase migration new",
    "db:list": "supabase migration list",
    "db:diff": "supabase db diff -f",
    "db:link": "supabase link",
    "db:push": "supabase db push",
    "db:push:dry": "supabase db push --dry-run",
    "db:seed:remote": "supabase db push --include-seed",
    "db:pull": "supabase db pull",
    "db:types": "supabase gen types typescript --local --schema public > src/database.types.ts",
    "db:types:remote": "supabase gen types typescript --linked --schema public > src/database.types.ts",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@pixelaula/api": "file:../shared/pixelaula-api",
    "@supabase/supabase-js": "^2.58.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jose": "^6.2.12",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.7",
    "supabase": "^2.116.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
